{
  "name": "ecocash-payment-sdk",
  "version": "2.0.0",
  "description": "An unofficial Node.js SDK for the EcoCash APIs: Instant (online) payments, refunds and reversals, Enterprise Cash-In, Disburse Change, Merchant to Subscriber and Transaction Lookup in Zimbabwe.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "sandbox": "node --env-file=.env -r ts-node/register examples/sandbox.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "homepage": "https://github.com/Unfiltered-On-GH/Ecocash-Payment-SDK-JS#readme",
  "bugs": {
    "url": "https://github.com/Unfiltered-On-GH/Ecocash-Payment-SDK-JS/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Unfiltered-On-GH/Ecocash-Payment-SDK-JS.git"
  },
  "keywords": [
    "ecocash",
    "payment",
    "zimbabwe",
    "mobile-money",
    "api",
    "sdk",
    "ecocash-api",
    "payment-gateway",
    "disbursement",
    "africa",
    "fintech",
    "mobile-payments"
  ],
  "author": "Tafadzwa Mabika (mabikatafadzwa@gmail.com)",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.11.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "@types/node": "^24.3.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  }
}
