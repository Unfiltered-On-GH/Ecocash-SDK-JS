# Copy to .env and fill in your sandbox values. .env is gitignored; never commit it.
# Run: npm run sandbox
# Wrap any value that contains # in double quotes, e.g. KEY="abc#123". Unquoted, the # starts
# a comment and the value is silently cut short (you then get SBX40100 / 401).

ECOCASH_ENV=sandbox

# --- EcoCash Instant Payments (Online Payments) ---
# Portal > Products > Instant Payments: Username and Password (HTTP Basic auth, used on every Online call).
# Not the same as the Payment Gateway credentials below.
ECOCASH_ONLINE_USERNAME=
ECOCASH_ONLINE_PASSWORD=
# Merchant fields: in the sandbox any value works (all are required, so don't leave them empty).
# For live, use the merchant details EcoCash gives you.
ECOCASH_MERCHANT_CODE=
# EcoCash docs say sandbox PINs pick the outcome (1111 E010, 2222 E006, 9999 E013); in testing they did not
ECOCASH_MERCHANT_PIN=0000
ECOCASH_MERCHANT_NUMBER=
ECOCASH_TERMINAL_ID=
ECOCASH_LOCATION=Harare
ECOCASH_MERCHANT_NAME=
ECOCASH_SUPER_MERCHANT_NAME=ECOCASH

# --- EPG services (Cash-In, Disburse Change, Merchant to Subscriber, Lookup) ---
# Portal > Products > Payment Gateway: Client ID and Client Secret (headers on every EPG call)
ECOCASH_CLIENT_ID=
ECOCASH_CLIENT_SECRET=
# Portal > Products > Payment Gateway > Channel API User. Needed for Cash-In, Disburse Change and
# Merchant to Subscriber, not for Lookup.
ECOCASH_API_USERNAME=epg-sandbox-user-v1
# Plain password; the SDK encrypts it with the encryption key on every request
ECOCASH_API_PASSWORD=
ECOCASH_ENCRYPTION_KEY=
# Or skip the two lines above and paste the encrypted password the portal generates ("Generate")
ECOCASH_API_ENCRYPTED_PASSWORD=

# --- Test customer number (an Econet number whitelisted for your sandbox) ---
ECOCASH_TEST_MSISDN=

# Optional: run the PIN matrix (1111, 2222, 9999) too. Set to 1 to enable.
ECOCASH_RUN_PIN_MATRIX=0
